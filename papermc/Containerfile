# PaperMC herunterladen und Prüfsumme verifizieren
FROM alpine:3.24 AS downloader

RUN apk add --no-cache curl

ARG MC_VERSION=26.3
ARG PAPER_BUILD
ARG PAPER_SHA256

RUN set -eu; \
    test -n "$PAPER_BUILD"; \
    test -n "$PAPER_SHA256"; \
    curl -fsSL --retry 3 \
      "https://fill-data.papermc.io/v1/objects/${PAPER_SHA256}/paper-${MC_VERSION}-${PAPER_BUILD}.jar" \
      -o /paper.jar; \
    echo "${PAPER_SHA256}  /paper.jar" | sha256sum -c -

# Schlanke Java-25-Runtime
FROM eclipse-temurin:25-jre-alpine-3.24

RUN mkdir -p /opt/paper /data

COPY --from=downloader --chown=10001:10001 \
    /paper.jar /opt/paper/paper.jar

WORKDIR /data

ENTRYPOINT ["java", "-Xms1G", "-Xmx3G", "-jar", "/opt/paper/paper.jar", "--nogui"]

